                </span>
            {% endif %}
        {% endset %}

        {% set text %}
            <div class="sf-toolbar-info-piece">
                <b>AceClient Requests</b>
                <span class="sf-toolbar-status">{{ collector.requestCount }}</span>
            </div>
            {% if collector.errorCount > 0 %}
                <div class="sf-toolbar-info-piece">
                    <b>Errors</b>
                    <span class="sf-toolbar-status sf-toolbar-status-red">{{ collector.errorCount }}</span>
                </div>
            {% endif %}
        {% endset %}

        {{ include('@WebProfiler/Profiler/toolbar_item.html.twig', { link: profiler_url, status: collector.errorCount > 0 ? 'red' : '' }) }}
    {% endif %}
{% endblock %}

{% block menu %}
    <span class="label {{ collector.requestCount == 0 ? 'disabled' }} {{ collector.errorCount > 0 ? 'label-status-error' : '' }}">
        <span class="icon"><img src="{{ asset('AceClient43/Resource/template/icon/logo.png', 'plugin') }}"/></span>
        <strong>Ace Client</strong>
        {% if collector.requestCount > 0 %}
            <span class="count">
                <span>{{ collector.requestCount }}</span>
            </span>
        {% endif %}
    </span>
{% endblock %}

{% block panel %}
    <h2>AceClient API Tracing</h2>

    {% if collector.requestCount == 0 %}
        <div class="empty">
            <p>No ACE API requests were recorded.</p>
        </div>
    {% else %}
        <div class="sf-tabs">
            {% for client_name, client_data in collector.clients %}
                {% if client_data.traces|length > 0 %}
                    <div class="tab">
                        <h3 class="tab-title">{{ client_name|title }} <span class="badge">{{ client_data.traces|length }}</span></h3>
                        <div class="tab-content">
                            {% for trace in client_data.traces %}
                                {% set request_id = client_name ~ '_' ~ loop.index0 %}
                                <div class="sf-profiler-httpclient-requests" id="request-{{ request_id }}">
                                    <h4>
                                        <span class="http-method">{{ trace.method }}</span>
                                        <span class="status-response-status-code status-{{ trace.status_code < 300 ? 'success' : (trace.status_code < 400 ? 'warning' : 'error') }}">{{ trace.status_code }}</span>
                                        {{ trace.full_url }}
                                    </h4>

                                    <script>
                                        allTraces['{{ request_id }}'] = {
                                            raw_request_data: {{ trace.raw_request_data|json_encode|raw }},
                                            raw_response_data: {{ trace.raw_response_data|json_encode|raw }},
                                            before_serialize_data: {{ trace.before_serialize_data_html|json_encode|raw }},
                                            deserialized_data: {{ trace.deserialized_data_html|json_encode|raw }},
                                            method: {{ trace.method|json_encode|raw }},
                                            url: {{ trace.full_url|json_encode|raw }}
                                        };
                                    </script>

                                    <div class="ace-tab-container">
                                        <div class="ace-tabs">
                                            <button class="ace-tab active" onclick="switchTab(this, '{{ request_id }}', 'metadata')">Metadata</button>
                                            <button class="ace-tab" onclick="switchTab(this, '{{ request_id }}', 'before-serialize')">Before Serialize</button>
                                            <button class="ace-tab" onclick="switchTab(this, '{{ request_id }}', 'raw-request')">Raw Request</button>
                                            <button class="ace-tab" onclick="switchTab(this, '{{ request_id }}', 'raw-response')">Raw Response</button>
                                            <button class="ace-tab" onclick="switchTab(this, '{{ request_id }}', 'deserialized')">Deserialized</button>
                                        </div>

                                        <!-- Metadata Tab -->
                                        <div id="{{ request_id }}-metadata" class="ace-tab-content active">
                                            <h5>Request & Response Metadata</h5>

                                            {% if trace.http_request_headers is defined and trace.http_request_headers is not empty %}
                                                <div class="ace-metadata-section">
                                                    <h6>Request Headers</h6>
                                                    <table class="ace-metadata-table">
                                                        {% for header, value in trace.http_request_headers %}
                                                            <tr>
                                                                <th>{{ header }}</th>
                                                                <td>{{ value is iterable ? value|join(', ') : value }}</td>
                                                            </tr>
                                                        {% endfor %}
                                                    </table>
                                                </div>
                                            {% endif %}

                                            {% if trace.http_response_headers is defined and trace.http_response_headers is not empty %}
                                                <div class="ace-metadata-section">
                                                    <h6>Response Headers</h6>
                                                    <table class="ace-metadata-table">
                                                        {% for header, value in trace.http_response_headers %}
                                                            <tr>
                                                                <th>{{ header }}</th>
                                                                <td>{{ value is iterable ? value|join(', ') : value }}</td>
                                                            </tr>
                                                        {% endfor %}
                                                    </table>
                                                </div>
                                            {% endif %}

                                            {% if trace.timing is defined and trace.timing is not empty %}
                                                <div class="ace-metadata-section">
                                                    <h6>Timing Information</h6>
                                                    <table class="ace-metadata-table">
                                                        {% for key, timing_value in trace.timing %}
                                                            <tr>
                                                                <th>{{ key|title|replace({'_': ' '}) }}</th>
                                                                <td>
                                                                    {% if key == 'total_time' %}
                                                                        {{ (timing_value * 1000)|number_format(2) }} ms
                                                                    {% else %}
                                                                        {{ timing_value }}
                                                                    {% endif %}
                                                                </td>
                                                            </tr>
                                                        {% endfor %}
                                                    </table>
                                                </div>
                                            {% endif %}

                                            {% if trace.metadata is defined and trace.metadata is not empty %}
                                                <div class="ace-metadata-section">
                                                    <h6>Additional Metadata</h6>
                                                    <table class="ace-metadata-table">
                                                        {% for key, meta_value in trace.metadata %}
                                                            <tr>
                                                                <th>{{ key|title|replace({'_': ' '}) }}</th>
                                                                <td>{{ meta_value is iterable ? meta_value|json_encode : meta_value }}</td>
                                                            </tr>
                                                        {% endfor %}
                                                    </table>
                                                </div>
                                            {% endif %}

                                            {% if (trace.http_request_headers is not defined or trace.http_request_headers is empty)
                                                and (trace.http_response_headers is not defined or trace.http_response_headers is empty)
                                                and (trace.timing is not defined or trace.timing is empty)
                                                and (trace.metadata is not defined or trace.metadata is empty) %}
                                                <div class="ace-data-empty">
                                                    <strong>No Metadata:</strong> Request headers, response headers, timing, and metadata information are not available
                                                </div>
                                            {% endif %}
                                        </div>

                                        <!-- Before Serialize Tab -->
                                        <div id="{{ request_id }}-before-serialize" class="ace-tab-content">
                                            <h5>Request Data (Before Serialization)
                                                {{ _self.compare_dropdown(request_id, 'before-serialize', collector) }}
                                            </h5>
                                            {% if trace.before_serialize_data_available and trace.before_serialize_data_html %}
                                                <div class="ace-dump-container">
                                                    {{ trace.before_serialize_data_html|raw }}
                                                </div>
                                            {% else %}
                                                <div class="ace-data-empty">
                                                    <strong>No Request Data:</strong> Request data before serialization is not available
                                                </div>
                                            {% endif %}
                                        </div>

                                        <!-- Raw Request Tab -->
                                        <div id="{{ request_id }}-raw-request" class="ace-tab-content">
                                            <h5>Raw Request Data
                                                {{ _self.compare_dropdown(request_id, 'raw-request', collector) }}
                                            </h5>
                                            {% if trace.raw_request_data_formatted is defined and trace.raw_request_data_formatted %}
                                                <div class="ace-raw-content">
                                                    <button class="ace-copy-button" onclick="copyToClipboard(this, {{ trace.raw_request_data|json_encode|e('html_attr') }})">Copy</button>{{ trace.raw_request_data_formatted }}
                                                </div>
                                            {% else %}
                                                <div class="ace-data-empty">
                                                    <strong>No Raw Request Data:</strong> Raw HTTP request data is not available
                                                </div>
                                            {% endif %}
                                        </div>

                                        <!-- Raw Response Tab -->
                                        <div id="{{ request_id }}-raw-response" class="ace-tab-content">
                                            <h5>Raw Response Data
                                                {{ _self.compare_dropdown(request_id, 'raw-response', collector) }}
                                            </h5>
                                            {% if trace.raw_response_data_formatted is defined and trace.raw_response_data_formatted %}
                                                <div class="ace-raw-content">
                                                    <button class="ace-copy-button" onclick="copyToClipboard(this, {{ trace.raw_response_data|json_encode|e('html_attr') }})">Copy</button>{{ trace.raw_response_data_formatted }}
                                                </div>
                                            {% else %}
                                                <div class="ace-data-empty">
                                                    <strong>No Raw Response Data:</strong> Raw HTTP response data is not available
                                                </div>
                                            {% endif %}
                                        </div>

                                        <!-- Deserialized Tab -->
                                        <div id="{{ request_id }}-deserialized" class="ace-tab-content">
                                            <h5>Deserialized Response Data
                                                {{ _self.compare_dropdown(request_id, 'deserialized', collector) }}
                                            </h5>
                                            {% if trace.deserialized_data_available and trace.deserialized_data_html %}
                                                <div class="ace-dump-container">
                                                    {{ trace.deserialized_data_html|raw }}
                                                </div>
                                            {% else %}
                                                <div class="ace-data-empty">
                                                    <strong>No Response Data:</strong> Deserialized response data is not available
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>

                                    {% if trace.error is defined and trace.error %}
                                        <div class="ace-data-error">
                                            <b>Error:</b> {{ trace.error.message }}
                                        </div>
                                    {% endif %}
                                </div>
                                <hr/>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
