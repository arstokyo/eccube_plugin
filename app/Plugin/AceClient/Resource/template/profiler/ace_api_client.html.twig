            background: #4fc3f7;
            color: #1a1a1a;
        }

        [data-theme="dark"] .ace-copy-button:hover {
            background: #29b6f6;
        }

        /* FIXED: Compare button styling for dark mode */
        [data-theme="dark"] .ace-compare-button {
            background: #4fc3f7;
            color: #1a1a1a;
        }

        .ace-dump-uninitialized {
            color: #999;
            font-style: italic;
            font-size: 0.9em;
        }

        .ace-dump-error {
            color: #e74c3c;
            font-style: italic;
            font-size: 0.9em;
        }

        /* Dark mode support for new styles */
        [data-theme="dark"] .ace-dump-uninitialized {
            color: #999;
        }

        [data-theme="dark"] .ace-dump-error {
            color: #ff6b6b;
        }

    </style>

    <script>
        let allTraces = {}; // Store all traces for comparison
        let currentTooltip = null; // Track current tooltip

        function switchTab(button, requestId, tabName) {
            // Hide all tab contents for this request
            const tabContents = document.querySelectorAll(`#request-${requestId} .ace-tab-content`);
            tabContents.forEach(content => {
                content.classList.remove('active');
            });

            // Remove active class from all tabs for this request
            const tabs = document.querySelectorAll(`#request-${requestId} .ace-tab`);
            tabs.forEach(tab => {
                tab.classList.remove('active');
            });

            // Show selected tab content and mark tab as active
            const targetContent = document.getElementById(`${requestId}-${tabName}`);
            if (targetContent) {
                targetContent.classList.add('active');
            }
            button.classList.add('active');
        }

        function toggleAceElement(elementId) {
            const element = document.getElementById(elementId);
            if (!element) {
                console.warn('Element not found for toggle:', elementId);
                return;
            }

            const toggle = element.previousElementSibling;
            if (!toggle) {
                console.warn('Toggle element not found for:', elementId);
                return;
            }

            if (element.classList.contains('ace-dump-hidden')) {
                element.classList.remove('ace-dump-hidden');
                toggle.classList.add('ace-dump-expanded');
                toggle.classList.remove('ace-dump-collapsed');
            } else {
                element.classList.add('ace-dump-hidden');
                toggle.classList.remove('ace-dump-expanded');
                toggle.classList.add('ace-dump-collapsed');
            }
        }

        function copyToClipboard(button, originalText) {
            const textToCopy = originalText;

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(textToCopy).then(() => {
                    showCopyFeedback(button, 'Copied!');
                }).catch((err) => {
                    console.warn('Clipboard API failed:', err);
                    fallbackCopyToClipboard(button, textToCopy);
                });
            } else {
                fallbackCopyToClipboard(button, textToCopy);
            }
        }

        function fallbackCopyToClipboard(button, text) {
            try {
                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.className = 'ace-copy-textarea';
                document.body.appendChild(textarea);

                textarea.focus();
                textarea.select();
                textarea.setSelectionRange(0, text.length);

                const successful = document.execCommand('copy');
                document.body.removeChild(textarea);

                if (successful) {
                    showCopyFeedback(button, 'Copied!');
                } else {
                    showCopyFeedback(button, 'Copy failed');
                }
            } catch (err) {
                console.error('Fallback copy failed:', err);
                showCopyFeedback(button, 'Copy failed');
            }
        }

        function showCopyFeedback(button, message) {
            const originalText = button.textContent;
            button.textContent = message;
            setTimeout(() => {
                button.textContent = originalText;
            }, 1000);
        }

        function showCompareDropdown(event, requestId, type) {
            event.preventDefault();
            event.stopPropagation();

            const button = event.currentTarget || event.target;
            const dropdown = button.nextElementSibling;

            console.log('Show dropdown clicked:', requestId, type, dropdown);
            console.log('Dropdown classes before:', dropdown.className);

            // Close other dropdowns first
            document.querySelectorAll('.ace-compare-dropdown').forEach(d => {
                if (d !== dropdown) {
                    d.classList.remove('show');
                }
            });

            // Toggle current dropdown - Fixed visibility toggle
            const isCurrentlyVisible = dropdown.classList.contains('show');
            console.log('Is currently visible:', isCurrentlyVisible);

            if (isCurrentlyVisible) {
                dropdown.classList.remove('show');
                console.log('Hiding dropdown');
            } else {
                dropdown.classList.add('show');
                console.log('Showing dropdown');
            }

            console.log('Dropdown classes after:', dropdown.className);
        }

        function compareWithRequest(currentRequestId, currentType, compareRequestId, compareType) {
            console.log('Comparing:', currentRequestId, currentType, 'with', compareRequestId, compareType);

            const currentData = allTraces[currentRequestId];
            const compareData = allTraces[compareRequestId];

            if (!currentData) {
                alert('Current comparison data not available for: ' + currentRequestId);
                return;
            }

            if (!compareData) {
                alert('Comparison data not available for: ' + compareRequestId);
                return;
            }

            let currentContent = '';
            let compareContent = '';

            // Get current content based on type
            switch(currentType) {
                case 'before-serialize':
                    currentContent = currentData.before_serialize_data || '';
                    break;
                case 'raw-request':
                    currentContent = currentData.raw_request_data || '';
                    break;
                case 'raw-response':
                    currentContent = currentData.raw_response_data || '';
                    break;
                case 'deserialized':
                    currentContent = currentData.deserialized_data || '';
                    break;
            }

            // Get compare content based on type
            switch(compareType) {
                case 'before-serialize':
                    compareContent = compareData.before_serialize_data || '';
                    break;
                case 'raw-request':
                    compareContent = compareData.raw_request_data || '';
                    break;
                case 'raw-response':
                    compareContent = compareData.raw_response_data || '';
                    break;
                case 'deserialized':
                    compareContent = compareData.deserialized_data || '';
                    break;
            }

            createSplitView(currentRequestId, currentType, compareRequestId, compareType, currentContent, compareContent);

            // Hide all compare dropdowns
            document.querySelectorAll('.ace-compare-dropdown').forEach(function(d) {
                d.classList.remove('show');
            });
        }

        function createSplitView(requestId1, type1, requestId2, type2, content1, content2) {
            const targetTab = document.getElementById(requestId1 + '-' + type1);

            if (!targetTab) {
                console.error('Target tab not found:', requestId1 + '-' + type1);
                return;
            }

            // Remove any existing split container first
            const existingSplit = targetTab.querySelector('.ace-split-container');
            if (existingSplit) {
                existingSplit.remove();
            }

            // Don't hide the original content, just find the container we want to replace
            const originalContainer = targetTab.querySelector('.ace-raw-content, .ace-dump-container');

            const splitContainer = document.createElement('div');
            splitContainer.className = 'ace-split-container';

            let formattedContent1 = content1;
            let formattedContent2 = content2;

            // FIXED: For raw data, ensure proper formatting AND coloring in split view
            if (type1.includes('raw-')) {
                const sourceTab = document.getElementById(requestId1 + '-' + type1);
                const sourceRawContent = sourceTab ? sourceTab.querySelector('.ace-raw-content') : null;
                if (sourceRawContent) {
                    // Clone the content and remove the copy button
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = sourceRawContent.innerHTML;
                    const copyButton = tempDiv.querySelector('.ace-copy-button');
                    if (copyButton) {
                        copyButton.remove();
                    }
                    formattedContent1 = tempDiv.innerHTML;
                } else {
                    // Apply proper XML formatting with indentation AND syntax highlighting
                    formattedContent1 = formatXmlStringToHtml(content1);
                }
            }

            if (type2.includes('raw-')) {
                const sourceTab = document.getElementById(requestId2 + '-' + type2);
                const sourceRawContent = sourceTab ? sourceTab.querySelector('.ace-raw-content') : null;
                if (sourceRawContent) {
                    // Clone the content and remove the copy button
                    const tempDiv = document.createElement('div');
                    tempDiv.innerHTML = sourceRawContent.innerHTML;
                    const copyButton = tempDiv.querySelector('.ace-copy-button');
                    if (copyButton) {
                        copyButton.remove();
                    }
                    formattedContent2 = tempDiv.innerHTML;
                } else {
                    // FIXED: Apply proper XML formatting with indentation AND syntax highlighting
                    formattedContent2 = formatXmlStringToHtml(content2);
                }
            }

            // For dump data, clone and make IDs unique to avoid conflicts
            if (type1 === 'before-serialize' || type1 === 'deserialized') {
                formattedContent1 = makeIdsUniqueForSplitView(content1, 'split1_');
            }
            if (type2 === 'before-serialize' || type2 === 'deserialized') {
                formattedContent2 = makeIdsUniqueForSplitView(content2, 'split2_');
            }

            splitContainer.innerHTML = `
                <div class="ace-split-pane" style="flex: 1;">
                    <div class="ace-split-header">
                        Current: ${requestId1.replace('_', ' ')} (${type1})
                        <button onclick="closeSplitView('${requestId1}', '${type1}')" style="background: none; border: none; color: inherit; cursor: pointer; float: right;">✕</button>
                    </div>
                    <div class="ace-split-content">
                        <div class="ace-content-wrapper ace-raw-content" style="height: 100%; overflow: auto; padding: 10px; background: var(--base-1); font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', Consolas, 'Courier New', monospace; font-size: 12px; line-height: 1.4; white-space: pre-wrap; word-wrap: break-word;">
                            ${formattedContent1}
                        </div>
                    </div>
                </div>
                <div class="ace-split-resizer"></div>
                <div class="ace-split-pane" style="flex: 1;">
                    <div class="ace-split-header">
                        Compare: ${requestId2.replace('_', ' ')} (${type2})
                    </div>
                    <div class="ace-split-content">
                        <div class="ace-content-wrapper ace-raw-content" style="height: 100%; overflow: auto; padding: 10px; background: var(--base-1); font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', Consolas, 'Courier New', monospace; font-size: 12px; line-height: 1.4; white-space: pre-wrap; word-wrap: break-word;">
                            ${formattedContent2}
                        </div>
                    </div>
                </div>
            `;

            // Instead of hiding the parent, hide only the original content container
            if (originalContainer) {
                originalContainer.style.display = 'none';
            }

            // Append split container to the tab
            targetTab.appendChild(splitContainer);

            // FIXED: Initialize resizer functionality
            initializeSplitResizer(splitContainer);

            // Re-initialize dump handlers for the split view content with proper event delegation
            initializeDumpHandlersForSplitView(splitContainer);

            console.log('Split view created successfully');
        }

        function initializeSplitResizer(splitContainer) {
            const resizer = splitContainer.querySelector('.ace-split-resizer');
            const leftPane = splitContainer.querySelector('.ace-split-pane:first-child');
            const rightPane = splitContainer.querySelector('.ace-split-pane:last-child');

            if (!resizer || !leftPane || !rightPane) {
                console.warn('Split resizer elements not found');
                return;
            }

            let isResizing = false;
            let startX = 0;
            let startLeftWidth = 0;
            let startRightWidth = 0;
            let containerWidth = 0;

            resizer.addEventListener('mousedown', function(e) {
                isResizing = true;
                startX = e.clientX;

                const containerRect = splitContainer.getBoundingClientRect();
                containerWidth = containerRect.width;

                const leftRect = leftPane.getBoundingClientRect();
                const rightRect = rightPane.getBoundingClientRect();

                startLeftWidth = leftRect.width;
                startRightWidth = rightRect.width;

                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';

                e.preventDefault();
            });

            document.addEventListener('mousemove', function(e) {
                if (!isResizing) return;

                const deltaX = e.clientX - startX;
                const newLeftWidth = startLeftWidth + deltaX;
                const newRightWidth = startRightWidth - deltaX;

                // Enforce minimum widths
                const minWidth = 200;
                if (newLeftWidth >= minWidth && newRightWidth >= minWidth) {
                    const leftFlex = newLeftWidth / containerWidth;
                    const rightFlex = newRightWidth / containerWidth;

                    leftPane.style.flex = `${leftFlex}`;
                    rightPane.style.flex = `${rightFlex}`;
                }

                e.preventDefault();
            });

            document.addEventListener('mouseup', function() {
                if (isResizing) {
                    isResizing = false;
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                }
            });
        }

        // FIXED: Enhanced function to make IDs unique and ensure proper onclick updating
        function makeIdsUniqueForSplitView(htmlContent, prefix) {
            if (!htmlContent) return htmlContent;

            // Create a temporary container to parse the HTML
            const tempContainer = document.createElement('div');
            tempContainer.innerHTML = htmlContent;

            // Find all elements with IDs and make them unique
            const elementsWithIds = tempContainer.querySelectorAll('[id]');
            const idMappings = new Map();

            elementsWithIds.forEach((element, index) => {
                const originalId = element.id;
                const newId = prefix + originalId + '_' + Date.now() + '_' + index;
                idMappings.set(originalId, newId);
                element.id = newId;
            });

            // Update any onclick attributes that reference the old IDs
            const elementsWithOnClick = tempContainer.querySelectorAll('[onclick]');
            elementsWithOnClick.forEach(element => {
                let onclickValue = element.getAttribute('onclick');
                idMappings.forEach((newId, originalId) => {
                    // Replace references to old IDs in onclick attributes
                    const patterns = [
                        new RegExp("toggleAceElement\\(['\"]" + originalId.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + "['\"]\\)", 'g'),
                        new RegExp("'" + originalId.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + "'", 'g'),
                        new RegExp('"' + originalId.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '"', 'g')
                    ];

                    patterns.forEach(pattern => {
                        if (pattern.toString().includes('toggleAceElement')) {
                            onclickValue = onclickValue.replace(pattern, `toggleAceElement('${newId}')`);
                        } else {
                            onclickValue = onclickValue.replace(pattern, `'${newId}'`);
                        }
                    });
                });
                element.setAttribute('onclick', onclickValue);
            });

            return tempContainer.innerHTML;
        }

        function closeSplitView(requestId, type) {
            const targetTab = document.getElementById(requestId + '-' + type);
            if (!targetTab) return;

            // Remove split container
            const splitContainer = targetTab.querySelector('.ace-split-container');
            if (splitContainer) {
                splitContainer.remove();
            }

            // Show the original content container
            const originalContainer = targetTab.querySelector('.ace-raw-content, .ace-dump-container');
            if (originalContainer) {
                originalContainer.style.display = 'block';
            }
        }

        // Fixed tooltip positioning system
        function setupTooltipSystem() {
            // Create tooltip element
            const tooltip = document.createElement('div');
            tooltip.className = 'ace-tooltip';
            document.body.appendChild(tooltip);
            currentTooltip = tooltip;

            // Handle tooltip on hover
            document.addEventListener('mouseover', function(e) {
                if (e.target.classList.contains('ace-dump-class') && e.target.hasAttribute('data-fqcn')) {
                    // Remove title to prevent browser tooltip
                    const fqcn = e.target.getAttribute('data-fqcn');
                    showTooltip(e.target, fqcn);
                }
            });

            document.addEventListener('mouseout', function(e) {
                if (e.target.classList.contains('ace-dump-class')) {
                    hideTooltip();
                }
            });

            // Hide tooltip on scroll
            document.addEventListener('scroll', hideTooltip, true);
        }

        function showTooltip(element, text) {
            if (!currentTooltip) return;

            currentTooltip.textContent = text;
            currentTooltip.classList.add('show');

            // Position tooltip above the element
            const rect = element.getBoundingClientRect();
            const tooltipRect = currentTooltip.getBoundingClientRect();

            let left = rect.left + (rect.width / 2) - (tooltipRect.width / 2);
            let top = rect.top - tooltipRect.height - 10; // 10px gap

            // Adjust if tooltip goes off screen
            if (left < 10) {
                left = 10;
            } else if (left + tooltipRect.width > window.innerWidth - 10) {
                left = window.innerWidth - tooltipRect.width - 10;
            }

            if (top < 10) {
                // If no space above, show below
                top = rect.bottom + 10;
                // Update arrow position for bottom placement
                currentTooltip.style.setProperty('--arrow-position', 'top');
            } else {
                currentTooltip.style.setProperty('--arrow-position', 'bottom');
            }

            currentTooltip.style.left = left + 'px';
            currentTooltip.style.top = top + 'px';
        }

        function hideTooltip() {
            if (currentTooltip) {
                currentTooltip.classList.remove('show');
            }
        }

        // FIXED: Enhanced XML formatting function that returns HTML with proper syntax highlighting
        // FIXED: Enhanced XML formatting function that properly formats AND applies syntax highlighting
        function formatXmlStringToHtml(xmlString) {
            if (!xmlString) return '';
            if (!xmlString.includes('<')) {
                return escapeHtml(xmlString);
            }

            try {
                // STEP 1: First properly format the XML with indentation (same logic as PHP formatXmlContent)
                let formatted = xmlString.trim();

                // Handle CDATA sections - preserve them during formatting
                const cdataRegex = /<!\[CDATA\[([\s\S]*?)\]\]>/g;
                const cdataPlaceholders = [];
                let cdataIndex = 0;

                formatted = formatted.replace(cdataRegex, (match, content) => {
                    const placeholder = `__CDATA_PLACEHOLDER_${cdataIndex}__`;
                    cdataPlaceholders[cdataIndex] = match;
                    cdataIndex++;
                    return placeholder;
                });

                // Add line breaks between tags (same as PHP: preg_replace('/>\s*</', ">\n<", $content))
                formatted = formatted.replace(/>\s*</g, '>\n<');

                // Split into lines and add proper indentation (same logic as PHP)
                const lines = formatted.split('\n');
                let indentLevel = 0;
                const indentedLines = [];

                lines.forEach(line => {
                    const trimmed = line.trim();
                    if (!trimmed) {
                        return; // Skip empty lines
                    }

                    // Decrease indent for closing tags (same as PHP: preg_match('/^<\//', $trimmed))
                    if (trimmed.match(/^<\//)) {
                        indentLevel = Math.max(0, indentLevel - 1);
                    }

                    // Add current line with indentation (same as PHP: str_repeat('  ', $indentLevel).$trimmed)
                    indentedLines.push('  '.repeat(indentLevel) + trimmed);

                    // Increase indent for opening tags (same logic as PHP)
                    // preg_match('/^<[^\/]/', $trimmed) && !preg_match('/\/>$/', $trimmed)
                    if (trimmed.match(/^<[^\/]/) && !trimmed.match(/\/>$/)) {
                        // Only increase if this line doesn't also contain the closing tag
                        // !preg_match('/<[^>]+>.*<\/[^>]+>/', $trimmed)
                        if (!trimmed.match(/<[^>]+>.*<\/[^>]+>/)) {
                            indentLevel++;
                        }
                    }
                });

                formatted = indentedLines.join('\n');

                // Restore CDATA sections
                cdataPlaceholders.forEach((cdata, index) => {
                    const placeholder = `__CDATA_PLACEHOLDER_${index}__`;
                    formatted = formatted.replace(placeholder, cdata);
                });

                // STEP 2: Now escape HTML entities for display
                formatted = formatted
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');

                // STEP 3: Apply syntax highlighting with proper color classes
                formatted = formatted
                    // XML tags (opening, closing, self-closing)
                    .replace(/(&lt;\/?[\w:-]+(?:\s[^&]*?)?\/?\s*&gt;)/g, '<span class="xml-tag">$1</span>')
                    // XML attributes with values
                    .replace(/(\w+)=(&quot;[^&]*?&quot;)/g, '<span class="xml-attr-name">$1</span>=<span class="xml-attr-value">$2</span>')
                    // XML comments
                    .replace(/(&lt;!--[\s\S]*?--&gt;)/g, '<span class="xml-comment">$1</span>')
                    // CDATA sections
                    .replace(/(&lt;!\[CDATA\[[\s\S]*?\]\]&gt;)/g, '<span class="xml-cdata">$1</span>')
                    // XML processing instructions
                    .replace(/(&lt;\?[\s\S]*?\?&gt;)/g, '<span class="xml-comment">$1</span>');

                return formatted;
            } catch (e) {
                console.warn('XML formatting failed:', e);
                return escapeHtml(xmlString);
            }
        }


        function formatXmlString(xmlString) {
            return formatXmlStringToHtml(xmlString);
        }

        function formatRawContentWithCopyButton(container) {
            const copyButton = container.querySelector('.ace-copy-button');
            if (!copyButton) return;

            const textNodes = [];
            const walker = document.createTreeWalker(
                container,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: function(node) {
                        if (copyButton.contains(node)) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        return NodeFilter.FILTER_ACCEPT;
                    }
                }
            );

            let node;
            while (node = walker.nextNode()) {
                textNodes.push(node.textContent);
            }

            const originalContent = textNodes.join('');

            if (!originalContent || !originalContent.includes('<')) {
                return;
            }

            try {
                const formattedContent = formatXmlStringToHtml(originalContent);
                container.innerHTML = formattedContent;
                container.appendChild(copyButton);
            } catch (e) {
                console.warn('XML formatting failed:', e);
            }
        }

        // Add function to escape HTML for raw content display
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // FIXED: Enhanced function to initialize dump handlers specifically for split view
        function initializeDumpHandlersForSplitView(container) {
            // Re-initialize toggle functionality for dump elements
            const toggles = container.querySelectorAll('.ace-dump-toggle');
            console.log('Found toggles in split view:', toggles.length);

            toggles.forEach((toggle, index) => {
                // FIXED: Remove onclick attribute and add proper event listener
                const onclickValue = toggle.getAttribute('onclick');
                if (onclickValue) {
                    // Extract the element ID from onclick attribute
                    const match = onclickValue.match(/toggleAceElement\(['"]([^'"]+)['"]\)/);
                    if (match) {
                        const targetElementId = match[1];
                        const targetElement = document.getElementById(targetElementId);

                        if (targetElement) {
                            console.log('Setting up toggle for split view element:', targetElementId);

                            // Remove the onclick to avoid conflicts
                            toggle.removeAttribute('onclick');

                            // Add proper event listener
                            toggle.addEventListener('click', function(e) {
                                e.preventDefault();
                                e.stopPropagation();

                                console.log('Toggle clicked for split view:', targetElementId);

                                // Perform the toggle operation
                                if (targetElement.classList.contains('ace-dump-hidden')) {
                                    targetElement.classList.remove('ace-dump-hidden');
                                    this.classList.add('ace-dump-expanded');
                                    this.classList.remove('ace-dump-collapsed');
                                } else {
                                    targetElement.classList.add('ace-dump-hidden');
                                    this.classList.remove('ace-dump-expanded');
                                    this.classList.add('ace-dump-collapsed');
                                }
                            });
                        } else {
                            console.warn('Target element not found for toggle in split view:', targetElementId);
                        }
                    }
                }
            });

            // Re-initialize tooltip functionality for class names
            const classElements = container.querySelectorAll('.ace-dump-class');
            classElements.forEach(classEl => {
                classEl.addEventListener('mouseenter', function(e) {
                    const fqcn = this.getAttribute('data-fqcn') || this.textContent;
                    showTooltip(this, fqcn);
                });

                classEl.addEventListener('mouseleave', function() {
                    hideTooltip();
                });
            });
        }

        // Keep the original function for backward compatibility
        function initializeDumpHandlers(container) {
            initializeDumpHandlersForSplitView(container);
        }

        // Close dropdowns when clicking outside
        document.addEventListener('click', function(event) {
            if (!event.target.closest('.ace-compare-selector')) {
                document.querySelectorAll('.ace-compare-dropdown').forEach(d => {
                    d.classList.remove('show');
                });
            }
        });

        // Format XML content on page load
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize all existing dump handlers
            setupTooltipSystem();

            document.querySelectorAll('.ace-raw-content').forEach(container => {
                formatRawContentWithCopyButton(container);
            });

            // Close dropdowns when clicking outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.ace-compare-selector')) {
                    document.querySelectorAll('.ace-compare-dropdown.show').forEach(dropdown => {
                        dropdown.classList.remove('show');
                    });
                }
            });
        });

    </script>
