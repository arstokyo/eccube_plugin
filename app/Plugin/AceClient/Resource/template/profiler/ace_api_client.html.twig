        }

        /* Improved raw content styling with XML formatting */
        .ace-raw-content {
            background: var(--base-1);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 12px 80px 12px 12px;
            font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', Consolas, 'Courier New', monospace;
            font-size: 12px;
            line-height: 1.4;
            white-space: pre-wrap;
            word-wrap: break-word;
            max-height: 600px;
            overflow-y: auto;
            position: relative;
        }

        /* XML syntax highlighting for raw content */
        .ace-raw-content .xml-tag {
            color: #0066cc;
        }

        .ace-raw-content .xml-attr-name {
            color: #cc0066;
        }

        .ace-raw-content .xml-attr-value {
            color: #27ae60;
        }

        .ace-raw-content .xml-comment {
            color: #888;
            font-style: italic;
        }

        .ace-raw-content .xml-cdata {
            color: #8e44ad;
            font-weight: bold;
        }

        .ace-copy-button {
            position: absolute;
            top: 8px;
            right: 8px;
            background: var(--color-link);
            color: var(--white);
            border: none;
            padding: 4px 8px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 11px;
            opacity: 0.8;
            z-index: 10;
            white-space: nowrap;
        }

        .ace-copy-button:hover {
            opacity: 1;
        }

        /* Hidden textarea for fallback copy functionality */
        .ace-copy-textarea {
            position: absolute;
            left: -9999px;
            opacity: 0;
            pointer-events: none;
        }

        .ace-data-empty {
            background: #fff3cd;
            border: 1px solid #ffeaa7;
            color: #856404;
            padding: 12px;
            border-radius: 4px;
            font-style: italic;
        }

        .ace-data-error {
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
            padding: 12px;
            border-radius: 4px;
        }

        /* Metadata table styling */
        .ace-metadata-table {
            width: 100%;
            border-collapse: collapse;
            margin: 8px 0;
            font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', Consolas, 'Courier New', monospace;
            font-size: 12px;
        }

        .ace-metadata-table th,
        .ace-metadata-table td {
            border: 1px solid var(--border-color);
            padding: 8px 12px;
            text-align: left;
            vertical-align: top;
        }

        .ace-metadata-table th {
            background: var(--base-2);
            font-weight: bold;
            width: 30%;
        }

        .ace-metadata-table td {
            background: var(--base-1);
            word-break: break-all;
        }

        .ace-metadata-section {
            margin: 16px 0;
        }

        .ace-metadata-section h6 {
            margin: 0 0 8px 0;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-color);
            font-weight: bold;
            color: var(--color-text);
        }

        /* Table styling improvements */
        .sf-profiler-httpclient-requests thead th {
