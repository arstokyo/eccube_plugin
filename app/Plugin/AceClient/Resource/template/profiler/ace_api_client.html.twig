            font-weight: bold;
        }

        .ace-split-content .ace-content-wrapper.ace-raw-content .xml-attr-value {
            color: #27ae60;
        }

        .ace-split-content .ace-content-wrapper.ace-raw-content .xml-comment {
            color: #888;
            font-style: italic;
        }

        .ace-split-content .ace-content-wrapper.ace-raw-content .xml-cdata {
            color: #8e44ad;
            font-weight: bold;
        }

        /* Dark mode support for split view XML highlighting */
        [data-theme="dark"] .ace-split-content .ace-content-wrapper.ace-raw-content .xml-tag {
            color: #4fc3f7;
            font-weight: bold;
        }

        [data-theme="dark"] .ace-split-content .ace-content-wrapper.ace-raw-content .xml-attr-name {
            color: #ff69b4;
            font-weight: bold;
        }

        [data-theme="dark"] .ace-split-content .ace-content-wrapper.ace-raw-content .xml-attr-value {
            color: #a5d6a7;
        }

        [data-theme="dark"] .ace-split-content .ace-content-wrapper.ace-raw-content .xml-comment {
            color: #9e9e9e;
            font-style: italic;
        }

        [data-theme="dark"] .ace-split-content .ace-content-wrapper.ace-raw-content .xml-cdata {
            color: #ba68c8;
            font-weight: bold;
        }

        .ace-compare-button {
            background: var(--color-link);
            color: var(--white);
            border: none;
            padding: 6px 12px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 12px;
            margin-left: 8px;
            font-weight: 500;
        }

        .ace-compare-button:hover {
            opacity: 0.8;
        }

        .ace-compare-selector {
            position: relative;
            display: inline-block;
        }

        .ace-compare-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            background: var(--base-0);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            z-index: 1000;
            min-width: 300px;
            max-width: 500px;
            max-height: 300px;
            overflow-y: auto;
            /* Fixed: Use visibility instead of display for better control */
            visibility: hidden;
            opacity: 0;
            transform: translateY(-5px);
            transition: all 0.2s ease;
            margin-top: 2px;
        }

        .ace-compare-dropdown.show {
            /* Fixed: Show dropdown properly */
            visibility: visible;
            opacity: 1;
            transform: translateY(0);
        }

        .ace-compare-option {
            padding: 10px 15px;
            cursor: pointer;
            border-bottom: 1px solid var(--border-color);
            font-size: 12px;
            line-height: 1.4;
            transition: background-color 0.2s ease;
        }

