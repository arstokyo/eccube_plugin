{% extends '@WebProfiler/Profiler/layout.html.twig' %}


{# Macro to generate compare dropdown for any tab type #}
{% macro compare_dropdown(request_id, current_type, collector) %}
    <div class="ace-compare-selector" style="float: right;">
        <button class="ace-compare-button" onclick="showCompareDropdown(event, '{{ request_id }}', '{{ current_type }}')">Compare</button>
        <div class="ace-compare-dropdown">
            {% for compare_client_name, compare_client_data in collector.clients %}
                {% for compare_trace in compare_client_data.traces %}
                    {% set compare_request_id = compare_client_name ~ '_' ~ loop.index0 %}
                    {# Include all requests, even the same one #}

                    {# Before Serialize option #}
                    {% if compare_trace.before_serialize_data_available %}
                        <div class="ace-compare-option" onclick="compareWithRequest('{{ request_id }}', '{{ current_type }}', '{{ compare_request_id }}', 'before-serialize')">
                            vs {{ compare_trace.method }} {{ compare_trace.full_url|default(compare_trace.uri|default('Unknown URL')) }} (Before Serialize)
                        </div>
                    {% endif %}

                    {# Raw Request option #}
                    {% if compare_trace.raw_request_data_formatted is defined and compare_trace.raw_request_data_formatted %}
                        <div class="ace-compare-option" onclick="compareWithRequest('{{ request_id }}', '{{ current_type }}', '{{ compare_request_id }}', 'raw-request')">
                            vs {{ compare_trace.method }} {{ compare_trace.full_url|default(compare_trace.uri|default('Unknown URL')) }} (Raw Request)
                        </div>
                    {% endif %}

                    {# Raw Response option #}
                    {% if compare_trace.raw_response_data_formatted is defined and compare_trace.raw_response_data_formatted %}
                        <div class="ace-compare-option" onclick="compareWithRequest('{{ request_id }}', '{{ current_type }}', '{{ compare_request_id }}', 'raw-response')">
                            vs {{ compare_trace.method }} {{ compare_trace.full_url|default(compare_trace.uri|default('Unknown URL')) }} (Raw Response)
                        </div>
                    {% endif %}

                    {# Deserialized option #}
                    {% if compare_trace.deserialized_data_available %}
                        <div class="ace-compare-option" onclick="compareWithRequest('{{ request_id }}', '{{ current_type }}', '{{ compare_request_id }}', 'deserialized')">
                            vs {{ compare_trace.method }} {{ compare_trace.full_url|default(compare_trace.uri|default('Unknown URL')) }} (Deserialized)
                        </div>
                    {% endif %}

                {% endfor %}
            {% endfor %}
        </div>
    </div>
{% endmacro %}

{% block head %}
    {{ parent() }}
    <style>
        /* Clean dump container styling with increased height */
        .ace-dump-container {
            background: var(--base-1);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 12px;
            margin: 8px 0;
            max-height: 800px;
            overflow-y: auto;
            font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', Consolas, 'Courier New', monospace;
            font-size: 13px;
            line-height: 1.5;
        }

        /* Custom dump styles for better nested visualization */
        .ace-dump-toggle {
            cursor: pointer;
            user-select: none;
            padding: 2px 4px;
            border-radius: 3px;
            transition: background-color 0.2s ease;
        }

        .ace-dump-toggle:hover {
            background-color: rgba(0, 123, 255, 0.1);
        }

        .ace-dump-arrow {
            display: inline-block;
            transition: transform 0.2s ease;
            width: 12px;
            font-family: monospace;
            color: #666;
        }

        .ace-dump-expanded .ace-dump-arrow {
            transform: rotate(90deg);
        }

        .ace-dump-content {
            margin-left: 16px;
        }

        .ace-dump-hidden {
            display: none;
        }

        /* Improved color scheme for better readability */
        .ace-dump-type {
            color: #0066cc;
            font-weight: bold;
        }

        .ace-dump-class {
            color: #cc0066;
            font-weight: bold;
            cursor: help;
            position: relative;
            display: inline-block;
            /* Fixed: Add background that covers full text width */
            background: rgba(204, 0, 102, 0.1);
            padding: 1px 2px;
            border-radius: 2px;
            transition: background-color 0.2s ease;
        }

        .ace-dump-class:hover {
            background: rgba(204, 0, 102, 0.2);
        }

        /* FQCN Tooltip Styles - Fixed positioning */
        .ace-tooltip {
            position: fixed;
            background: rgba(0, 0, 0, 0.95);
            color: white;
            padding: 6px 10px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: normal;
            white-space: normal;
            z-index: 9999;
            pointer-events: none;
            word-wrap: break-word;
            word-break: break-all;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
            opacity: 0;
            transition: opacity 0.2s ease;
            font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', Consolas, 'Courier New', monospace;
            width: auto;
        }

        .ace-tooltip.show {
            opacity: 1;
        }

        .ace-tooltip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 6px solid transparent;
            border-top-color: rgba(0, 0, 0, 0.95);
        }

        .ace-dump-count {
            color: #888;
            font-size: 0.9em;
            margin-left: 4px;
        }

        .ace-dump-key {
            color: #0066cc;
            font-weight: 600;
        }

        .ace-dump-property-name {
            color: #0066cc;
            font-weight: 600;
        }

        .ace-dump-arrow-right {
            color: #666;
            margin: 0 4px;
        }

        .ace-dump-visibility {
            font-size: 0.8em;
            font-weight: bold;
            margin-right: 4px;
        }

        .ace-dump-private {
            color: #d73027;
        }

        .ace-dump-protected {
            color: #fd8c00;
        }

        .ace-dump-public {
            color: #2ca02c;
        }

        .ace-dump-null {
            color: #999;
            font-style: italic;
        }

        .ace-dump-bool {
            color: #8e44ad;
            font-weight: bold;
        }

        .ace-dump-num {
            color: #e74c3c;
        }

        .ace-dump-str {
            color: #27ae60;
        }

        .ace-dump-bracket {
            color: #555;
            font-weight: bold;
        }

        .ace-dump-item, .ace-dump-property {
