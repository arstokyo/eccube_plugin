<div class="row js-ace-payment-id-row" style="display: none;">
    <div class="col-3"><span>{{ 'ace_client.admin.payment.label.ace_payment_id'|trans }}</span></div>
    <div class="col mb-2">
        {{ form_widget(form.ace_payment_id) }}
        {{ form_errors(form.ace_payment_id) }}
    </div>
</div>

<script>
$(function() {
    var aceRow = $('.js-ace-payment-id-row');
    var targetRow = $('#payment_register_method').closest('.row');

    if (targetRow.length && aceRow.length) {
        targetRow.after(aceRow);
        aceRow.show();
    }
});
</script>
