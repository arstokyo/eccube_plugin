{# Render ACE Customer ID below the Customer.id row on admin customer edit page #}
{% if Customer is defined and Customer.id %}
<div class="row mb-2 js-ace-customer-id-row" style="display:none;">
    <div class="col-3">
        <div class="d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="ACE 顧客ID">
            <span>{{ 'ace_client.admin.customer.label.ace_customer_id'|trans }}</span>
            <i class="fa fa-question-circle fa-lg ms-1"></i>
        </div>
    </div>
    <div class="col">
        <p class="text-monospace">{{ Customer.aceCustomerId ?? '-' }}</p>
    </div>
</div>
<script>
(function() {
    // Ensure DOM is ready
    function onReady(fn){ if (document.readyState !== 'loading') { fn(); } else { document.addEventListener('DOMContentLoaded', fn); } }

    onReady(function() {
        var idValue = {{ Customer.id|json_encode|raw }};
        var $ = window.jQuery || window.$;

        // Find the row that displays the Customer.id (a row with a <p> that equals idValue)
        function findCustomerIdRow() {
            // Search candidates: rows with p under a .col
            var rows = document.querySelectorAll('.row.mb-2');
            for (var i = 0; i < rows.length; i++) {
                var p = rows[i].querySelector('.col > p');
                if (!p) continue;
                var text = (p.textContent || '').trim();
                if (text === String(idValue)) {
                    return rows[i];
                }
            }
            return null;
        }

        var idRow = findCustomerIdRow();
        var aceRow = document.querySelector('.js-ace-customer-id-row');

        if (idRow && aceRow) {
            // Insert our block right after the Customer.id row
            idRow.parentNode.insertBefore(aceRow, idRow.nextSibling);
            aceRow.style.display = '';
        } else if ($ && aceRow) {
            // Fallback: try jQuery-based selector
            var $row = $('.row.mb-2').filter(function() {
                var $p = $(this).find('> .col > p');
                return $p.length && $.trim($p.text()) === String(idValue);
            }).first();
            if ($row.length) {
                $(aceRow).insertAfter($row).show();
            }
        }
    });
})();
</script>
{% endif %}
