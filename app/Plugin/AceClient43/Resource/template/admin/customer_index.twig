{% if pagination is defined and pagination|length > 0 %}
<script>
(function() {
    function onReady(fn){ if (document.readyState !== 'loading') { fn(); } else { document.addEventListener('DOMContentLoaded', fn); } }

    onReady(function() {
        var table = document.querySelector('.c-primaryCol table.table');
        if (!table) return;

        var theadRow = table.querySelector('thead tr');
        if (!theadRow) return;

        // 1) Insert ACE header TH right after the first TH (会員ID), only once.
        var aceHeaderText = {{ 'ace_client.admin.customer.label.ace_customer_id'|trans|json_encode|raw }};
        if (!theadRow.querySelector('th.js-ace-header')) {
            var th = document.createElement('th');
            th.className = 'border-top-0 pt-2 pb-3 text-nowrap';
            th.classList.add('js-ace-header');
            th.textContent = aceHeaderText;

            var firstTh = theadRow.querySelector('th');
            if (firstTh && firstTh.parentNode) {
                if (firstTh.nextSibling) {
                    theadRow.insertBefore(th, firstTh.nextSibling);
                } else {
                    theadRow.appendChild(th);
                }
            } else {
                theadRow.appendChild(th);
            }
        }

        // 2) Build a map of customer_id -> ACE ID
        var aceMap = {};
        {% for Customer in pagination %}
        aceMap[{{ Customer.id|json_encode|raw }}] = {{ (Customer.aceCustomerId ?? '-')|json_encode|raw }};
        {% endfor %}

        // 3) For each data row, insert a TD with the ACE ID right after the first TD (Customer.id).
        var rows = table.querySelectorAll('tbody tr[id^="ex-customer-"]');
        rows.forEach(function(tr) {
            if (tr.querySelector('td.js-ace-cell')) {
                return; // already inserted
            }
            var id = tr.id.replace('ex-customer-', '');
            var aceVal = aceMap[id] || '-';

            var firstTd = tr.querySelector('td');
            if (!firstTd) return;

            var td = document.createElement('td');
            td.className = 'align-middle';
            td.classList.add('js-ace-cell');
            td.innerHTML = '<span class="text-monospace"></span>';
            td.querySelector('span').textContent = String(aceVal);

            if (firstTd.nextSibling) {
                tr.insertBefore(td, firstTd.nextSibling);
            } else {
                tr.appendChild(td);
            }
        });
    });
})();
</script>
{% endif %}
