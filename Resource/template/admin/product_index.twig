{% if pagination is defined and pagination|length > 0 %}
<div class="card rounded border-0 mb-4">
    <div class="card-header">
        <div class="row">
            <div class="col-8">
                <span class="card-title">{{ 'ace_client.admin.product.title.sync_from_ace'|trans }}</span>
            </div>
        </div>
    </div>
    <div class="card-body">
        <form id="sync_form" method="post" action="{{ url('ace_client_admin_product_sync_from_ace') }}">
            <div class="row mb-2">
                <div class="col-12">
                    <div class="row mb-2">
                        <div class="col-3">
                            <span>{{ 'ace_client.admin.product.label.sync_status'|trans }}</span>
                        </div>
                        <div class="col">
                            <span id="sync_status" class="badge bg-secondary">{{ 'ace_client.admin.product.status.not_synced'|trans }}</span>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-3">
                            <label for="ace_product_ids">{{ 'ace_client.admin.product.label.ace_product_ids'|trans }}</label>
                        </div>
                        <div class="col">
                            <textarea id="ace_product_ids" name="ace_product_ids" class="form-control" rows="3" placeholder="{{ 'ace_client.admin.product.placeholder.ace_product_ids'|trans }}"></textarea>
                            <div id="ace_product_ids_error" class="invalid-feedback" style="display: none;"></div>
                            <div id="ace_product_success_message" class="alert alert-success mt-2" style="display: none;"></div>
                            <div id="ace_product_error_message" class="alert alert-danger mt-2" style="display: none;"></div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-3"></div>
                        <div class="col">
                            <button type="button" id="sync_from_ace" class="btn btn-ec-conversion">
                                {{ 'ace_client.admin.product.button.sync_from_ace'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
(function() {
    function onReady(fn) {
        if (document.readyState !== 'loading') {
            fn();
        } else {
            document.addEventListener('DOMContentLoaded', fn);
        }
    }

    onReady(function() {
        // Find the target element to insert our form before
        var targetElement = document.querySelector('.c-contentsArea__cols');
        if (!targetElement) return;

        // Get our sync form
        var syncFormContainer = document.getElementById('sync_form').closest('.card');
        if (!syncFormContainer) return;

        // Remove the form from its current position
        syncFormContainer.parentNode.removeChild(syncFormContainer);

        // Insert the form before the target element
        targetElement.parentNode.insertBefore(syncFormContainer, targetElement);

        // Handle form submission
        var syncButton = document.getElementById('sync_from_ace');
        var syncForm = document.getElementById('sync_form');
        var productIdsInput = document.getElementById('ace_product_ids');
        var syncStatus = document.getElementById('sync_status');
        var errorDisplay = document.getElementById('ace_product_ids_error');
        var successMessage = document.getElementById('ace_product_success_message');
        var errorMessage = document.getElementById('ace_product_error_message');

        syncButton.addEventListener('click', function(e) {
            e.preventDefault();

            // Reset displays
            errorDisplay.style.display = 'none';
            successMessage.style.display = 'none';
            errorMessage.style.display = 'none';
            productIdsInput.classList.remove('is-invalid');

            // Validate input
            var productIds = productIdsInput.value.trim();
            if (!productIds) {
                errorDisplay.textContent = "{{ 'ace_client.admin.product.error.product_ids_required'|trans }}";
                errorDisplay.style.display = 'block';
                productIdsInput.classList.add('is-invalid');
                return;
            }

            // Check if input contains only numbers, commas, and whitespace
            if (!/^[0-9,\s]*$/.test(productIds)) {
                errorDisplay.textContent = "{{ 'ace_client.admin.product.error.invalid_product_ids'|trans }}";
                errorDisplay.style.display = 'block';
                productIdsInput.classList.add('is-invalid');
                return;
            }

            // Disable button and show loading state
            syncButton.disabled = true;
            syncButton.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> {{ "ace_client.admin.product.button.syncing"|trans }}';

            // Update status
            syncStatus.className = 'badge bg-info';
            syncStatus.textContent = "{{ 'ace_client.admin.product.status.syncing'|trans }}";

            // Submit form via AJAX
            var formData = new FormData();
            formData.append('ace_product_ids', productIds);

            fetch(syncForm.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                // Re-enable button
                syncButton.disabled = false;
                syncButton.innerHTML = "{{ 'ace_client.admin.product.button.sync_from_ace'|trans }}";

                if (data.success) {
                    // Update status to success
                    syncStatus.className = 'badge bg-success';
                    syncStatus.textContent = "{{ 'ace_client.admin.product.status.success'|trans }}";

                    // Show success message
                    if (data.message) {
                        successMessage.textContent = data.message;
                        successMessage.style.display = 'block';
                    }
                } else {
                    // Update status to error
                    syncStatus.className = 'badge bg-danger';
                    syncStatus.textContent = "{{ 'ace_client.admin.product.status.error'|trans }}";

                    // Show error message
                    if (data.message) {
                        errorMessage.textContent = data.message;
                        errorMessage.style.display = 'block';
                    }
                }
            })
            .catch(error => {
                // Re-enable button
                syncButton.disabled = false;
                syncButton.innerHTML = "{{ 'ace_client.admin.product.button.sync_from_ace'|trans }}";

                // Update status to error
                syncStatus.className = 'badge bg-danger';
                syncStatus.textContent = "{{ 'ace_client.admin.product.status.error'|trans }}";

                // Show error message
                errorMessage.textContent = "{{ 'ace_client.admin.product.error.ajax_error'|trans }}";
                errorMessage.style.display = 'block';
                console.error('Error:', error);
            });
        });
    });
})();
</script>
{% endif %}
