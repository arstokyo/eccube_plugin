 {# 各支払方法のACE決済IDを隠し要素として出力 #}
  <div id="ace-payment-data" style="display: none;">
      {% for Payment in Payments %}
          <span data-payment-id="{{ Payment.id }}" data-ace-payment-id="{{ Payment.acePaymentId ?? '' }}"></span>
      {% endfor %}
  </div>

  <script>
  $(function() {
      var aceLabel = '{{ 'ace_client.admin.payment.label.ace_payment_id'|trans }}';

      // ヘッダーに列を追加
      $('.list-group-item .row').first().find('.col-auto').eq(1).after(
         '<div class="col-auto" style="min-width: 100px;"><strong>' + aceLabel + '</strong></div>'
      );

      // 各行にACE決済IDを追加
      $('#ace-payment-data span').each(function() {
          var paymentId = $(this).data('payment-id');
          var acePaymentId = $(this).data('ace-payment-id');
          var displayValue = acePaymentId !== '' ? acePaymentId : '-';

          $('#ex-payment-' + paymentId + ' .row .col-auto').eq(1).after(
            '<div class="col-auto d-flex align-items-center" style="min-width: 100px;">' + displayValue + '</div>'
          );
      });
  });
  </script>
