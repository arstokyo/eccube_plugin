{% extends 'default_frame.twig' %}

{% set mypageno = 'index' %}

{% set body_class = 'mypage' %}

{% block javascript %}
<script>
    $(document).ready(function() {
    $(".ec-definitions.format-date").each(function(){
        var dateString = $(this).find('span').text();
        var year = dateString.substring(0, 4);
        var month = dateString.substring(4, 6);
        var day = dateString.substring(6, 8);
        var formattedDate = year + "/" + month + "/" + day;
        $(this).find('span').text(formattedDate);
    })
});
</script>
{% endblock %}

{% block main %}
    <div>
        <div class="ec-mypageRole">
            <div class="ec-pageHeader">
                <h1>{{ 'マイページ'|trans }}/{{ 'ご注文履歴詳細'|trans }}</h1>
            </div>
            {% include 'Mypage/navi.twig' %}
        </div>

        {% set remessage = false %}

        <div class="ec-orderRole">
            <div class="ec-orderRole__detail">
                <div class="ec-orderOrder">
                    <div class="ec-definitions">
                        <dt>{{ 'ご注文日時'|trans }}</dt>
                        <dd>{{ order_date|date_sec }}</dd>
                    </div>
                    <div class="ec-definitions">
                        <dt>{{ 'ご注文番号'|trans }}</dt>
                        <dd>{{ order_no }}</dd>
                    </div>
                    {% if BaseInfo.option_mypage_order_status_display %}
                        <div class="ec-definitions">
                            <dt>{{ 'ご注文状況'|trans }}</dt>
                            <dd>{{ order_status }}<dd>
                        </div>
                    {% endif %}
                    {% if hday %}
                        <div class="ec-definitions format-date">
                            <dt>{{ 'お届け予定日'|trans }}</dt>
                            <dd><span>{{ hday }}</span><dd>
                        </div>
                    {% endif %}
                </div>
                <div class="ec-orderDelivery">
                    <div class="ec-rectHeading">
                        <h2>{{ '配送情報'|trans }}</h2>
                    </div>
                    {% set ProductClassRepository = repository('Eccube\\Entity\\ProductClass') %}
                    {% set utax = 0 %}
                    {% set stax = 0 %}
                    {% set allSubTotal = 0 %}
                    <div class="ec-orderDelivery__title">{{ 'お届け先'|trans }}</div>
                    {% for OrderItem in Order %}
                        {% set ProductClass = ProductClassRepository.findOneBy({'code': OrderItem['gcode']}) %}
                        {% if ProductClass is not empty %}
                            {% set itemTotal = (OrderItem['tanka'] + (OrderItem['stax'] / OrderItem['suu'])) * OrderItem['suu'] %}
                            {% set allSubTotal = allSubTotal + itemTotal %}
                            {% set Product = ProductClass.Product %}
                            <div class="ec-orderDelivery__item">
                                <div class="ec-imageGrid">
                                    <div class="ec-imageGrid__img">
                                        {% if Product is null %}
                                            <img src="{{ asset(''|no_image_product, 'save_image') }}"/>
                                        {% else %}
                                            <img src="{{ asset(Product.MainListImage|no_image_product, 'save_image') }}"
                                                 alt="{{ Product.name }}"/>
                                        {% endif %}
                                    </div>
                                    <div class="ec-imageGrid__content">
                                        <p>
                                            {% if Product is not null and Product.Status.id == constant('Eccube\\Entity\\Master\\ProductStatus::DISPLAY_SHOW') %}
                                                <a href="{{ url('product_detail', {'id': Product.id}) }}">{{ Product.name }}</a>
                                            {% else %}
                                                {{ Product.name }}
                                            {% endif %} ×{{ OrderItem['suu'] }}
                                        </p>
                                        <p>{{ (OrderItem['tanka'] + (OrderItem['stax'] / OrderItem['suu']))|price }}
                                            × {{ OrderItem['suu']|number_format }}</p>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        {% set utax = utax + OrderItem['utax'] %}
                        {% set stax = stax + OrderItem['utax'] %}
                    {% endfor %}

                    <div class="ec-orderDelivery__address">
                        <p>{{ Order[0]['simei'] }}</p>
                        <p>{{ '〒'|trans }}{{ Order[0]['zip'] }} {{ Order[0]['adr'] }}</p>
                        <p>{{ Order[0]['tel'] }}</p>
                    </div>
                    {% if send_number is not empty %}
                        <div class="ec-definitions--soft">
                            <dt>{{ '送り状ナンバー'|trans }} :</dt>
                            <dd>{{ send_number|default(null) }}</dd>
                        </div>
                    {% endif %}
                    {% if sending_url is not empty %}
                        <div class="ec-definitions--soft">
                            <dt>{{ '送り状URL'|trans }} :</dt>
                            {% for url in sending_url|split(',') %}
                                <dd><a class="ec-definitions--url" href="{{ url|default(''|trans) }}" target="_blank" rel="noopener">{{ url|default(''|trans) }}</a></dd>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
                <div class="ec-orderPayment">
                    <div class="ec-rectHeading">
                        <h2>{{ 'お支払い情報'|trans }}</h2>
                    </div>
                    <p>{{ 'お支払い方法'|trans }} : {{ payment }}</p>
                </div>

            </div>
            <div class="ec-orderRole__summary">
                <div class="ec-totalBox">
                    <dl class="ec-totalBox__spec">
                        <dt>{{ '小計'|trans }}</dt>
                        <dd>{{ allSubTotal|price }}</dd>
                    </dl>
                    <dl class="ec-totalBox__spec">
                        <dt>{{ '手数料'|trans }}</dt>
                        <dd>{{ charge|price }}</dd>
                    </dl>
                    <dl class="ec-totalBox__spec">
                        <dt>{{ '送料'|trans }}</dt>
                        <dd>{{ delivery_fee_total|price }}</dd>
                    </dl>
                    <dl class="ec-totalBox__spec">
                        <dt>{{ '値引き'|trans }}</dt>
                        <dd>{{ nebiki|price }}</dd>
                    </dl>
                    <div class="ec-totalBox__paymentTotal">{{ '合計'|trans }}<span class="ec-totalBox__price">{{ payment_total|price }}</span><span class="ec-totalBox__taxLabel">{{ '税込'|trans }}</span></div>
                    <dl class="ec-totalBox__taxRate">
                        <dt>{{ '内消費税'|trans }}</dt>
                        <dd>{{ (utax + stax)|price }}</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="ec-role ec-orderRole">
            <div class="ec-orderRole__detail">
                <a href="{{ url('mypage', { 'pageno': pageno }) }}" class="ec-inlineBtn ec-font-bold">{{ '戻る'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
