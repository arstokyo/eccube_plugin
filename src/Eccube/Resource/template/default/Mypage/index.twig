{% extends 'default_frame.twig' %}

{% set mypageno = 'index' %}

{% set body_class = 'mypage' %}

{% block stylesheet %}
    <style>
        .ec-pager .ec-pager__item a,
        .ec-pager .ec-pager__item--active a {
            position: relative;
            display: block;
            color: #437ec4;
            background-color: #fff;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        .ec-pager .ec-pager__item--active a {
            z-index: 3;
            color: white;
            background-color: #437ec4;
            border-color: #437ec4;
        }
    </style>
{% endblock %}
{% block javascript %}
<script>
    $(document).ready(function() {
    $(".ec-definitions.format-date").each(function(){
        var dateString = $(this).find('span').text();
        var year = dateString.substring(0, 4);
        var month = dateString.substring(4, 6);
        var day = dateString.substring(6, 8);
        var formattedDate = year + "/" + month + "/" + day;
        $(this).find('span').text(formattedDate);
    })
});
</script>
{% endblock %}
{% block main %}
    <div>
        <div class="ec-mypageRole">
            <div class="ec-pageHeader">
                <h1>{{ 'マイページ'|trans }}/{{ 'ご注文履歴'|trans }}</h1>
            </div>
            {% include 'Mypage/navi.twig' %}
        </div>
        <div class="ec-mypageRole">
            {% if Orders|length > 0 %}
                <p class="ec-para-normal">{{ '%count%件の履歴があります'|trans({'%count%':Orders|length}) }}</p>
                {% for Order in Orders %}
                    <div class="ec-historyRole">
                        <div class="ec-historyRole__contents">

                            <div class="ec-historyRole__header">
                                <div class="ec-historyListHeader">
                                    <p class="ec-historyListHeader__date">{{ Order['day']|date_sec }}</p>
                                    <dl class="ec-definitions">
                                        <dt>{{ 'ご注文番号'|trans }}</dt>
                                        <dd>{{ Order['denno'] }}</dd>
                                    </dl>
                                    {% set order_status = '発送済み' %}
                                    {% if (BaseInfo.option_mypage_order_status_display) %}
                                        <dl class="ec-definitions">
                                            <dt>{{ 'ご注文状況'|trans }}</dt>
                                            {{ Order["status"]}}
                                        </dl>
                                    {% endif %}
                                    {% if Order["hday"] %}
                                        <dl class="ec-definitions format-date">
                                            <dt>{{ 'お届け予定日'|trans }}</dt>
                                            <span>{{ Order["hday"] }}</span>
                                        </dl>
                                    {% endif %}
                                    <p class="ec-historyListHeader__action">
                                        {% set sending_url = '' %}
                                        {% if 'URL' in Order|keys %}
                                            {% set sending_url = Order['url'] %}
                                        {% endif %}

                                        <a class="ec-inlineBtn" href="{{ url('mypage_history', { 'order_no': Order['denno'], 'pageno': pageno}) }}">{{ '詳細を見る'|trans }}</a>

                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
                <div class="ec-pagerRole">
                    <ul
                            class="ec-pager">
                        {# 前へ #}
                        {% if is_prev %}
                            <li class="ec-pager__item">
                                <a href="{{ path( app.request.attributes.get('_route'), app.request.query.all|merge({'pageno': (pageno - 1)})) }}">{{ '前へ'|trans }}</a>
                            </li>
                        {% endif %}

                        <li class="ec-pager__item--active">
                            <a href="{{ path( app.request.attributes.get('_route'), app.request.query.all|merge({'pageno': pageno})) }}">
                                {{ pageno }}
                            </a>
                        </li>

                        {# 次へ #}
                        {% if is_next %}
                            <li class="ec-pager__item">
                                <a href="{{ path( app.request.attributes.get('_route'), app.request.query.all|merge({'pageno': (pageno + 1)})) }}">{{ '次へ'|trans }}</a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            {% else %}
                <p class="ec-para-normal">{{ 'ご注文履歴はありません。'|trans }}</p>
            {% endif %}
        </div>
    </div>
{% endblock %}
